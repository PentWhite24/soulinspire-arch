=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="55" y="630" /><mxPoint x="320" y="630" /><mxPoint x="320" y="290" /></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#232F3E;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="igw" target="ec2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="290" /></Array></mxGeometry></mxCell><mxCell id="d1" value="SSH :22 – git pull, restart node" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#7D8998;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dev" target="ec2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="720" /><mxPoint x="560" y="345" /></Array></mxGeometry></mxCell><mxCell id="d3" value="basic metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#7D8998;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ec2" target="cw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Environment notes&lt;/b&gt; (details not visible as icons)&lt;br&gt;• Security group inbound: 22/tcp, 80/tcp and 3000/tcp open to 0.0.0.0/0&lt;br&gt;• No load balancer, no Auto Scaling group, no NAT Gateway, no private subnets&lt;br&gt;• Resources created by hand in the console; no infrastructure-as-code or containers&lt;br&gt;• Backups: no EBS snapshots, no S3 versioning, no written recovery plan" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF8E6;strokeColor=#D9A21B;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="340" y="830" width="760" height="110" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;━━━ Customer traffic&lt;br&gt;- - - - Admin / supporting flow&lt;br&gt;Green = public subnet" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#7D8998;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1120" y="830" width="230" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>